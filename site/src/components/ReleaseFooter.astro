---
import Default from "@astrojs/starlight/components/Footer.astro"
import rootPackageJson from "../../../package.json"
---

<Default />
<p class="release-context">
  Documentation generated for <code>{rootPackageJson.name}@{rootPackageJson.version}</code>. Canonical source and edit history remain in the public repository. GuildControl is an independent project and is not affiliated with or endorsed by Discord Inc. Discord is used only to identify the platform that GuildControl connects to.
</p>

<style>
  .release-context {
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    margin: 1.5rem 0 0;
    padding: 1rem 0;
  }

  .release-context code {
    color: var(--sl-color-text-accent);
  }
</style>
