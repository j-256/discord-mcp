---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"

export const prerender = true

const NOT_FOUND_URL = "https://j-256.github.io/discord-mcp/404.html"
---

<StarlightPage
  frontmatter={{
    description: "Recover from a missing Discord MCP documentation route",
    editUrl: false,
    head: [
      { tag: "link", attrs: { href: NOT_FOUND_URL, rel: "canonical" } },
      { tag: "meta", attrs: { content: NOT_FOUND_URL, property: "og:url" } },
    ],
    hero: {
      actions: [
        {
          icon: "right-arrow",
          link: "/discord-mcp/start/choose/",
          text: "Choose a path",
          variant: "primary",
        },
        {
          icon: "open-book",
          link: "/discord-mcp/",
          text: "Documentation home",
        },
      ],
      tagline: "The route may have moved. Search the docs, choose an outcome, or return to the verified-read path.",
      title: "Page not found",
    },
    pagefind: false,
    template: "splash",
    title: "Page not found",
  }}
  hasSidebar={false}
>
  <p>Use the documentation search for an exact capability, or return to the path chooser for setup, fit, recovery, verification, and contribution routes.</p>
</StarlightPage>
