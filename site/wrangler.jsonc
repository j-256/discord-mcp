{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guildcontrol",
  "compatibility_date": "2026-08-30",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
