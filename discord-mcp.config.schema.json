        },
        "guildTemplateChanges": {
          "type": "boolean",
          "description": "Enable guild template changes policy"
        },
        "integrationAudit": {
          "type": "boolean",
          "description": "Enable integration audit policy"
        },
        "integrationDeletions": {
          "type": "boolean",
