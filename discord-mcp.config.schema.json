        },
        "inviteDeletions": {
          "type": "boolean",
          "description": "Enable invite deletions policy"
        },
        "memberDirectory": {
          "type": "boolean",
          "description": "Enable member directory policy"
        },
        "nicknameChanges": {
          "type": "boolean",
          "description": "Enable nickname changes policy"
        },
        "otherMemberNicknameChanges": {
          "type": "boolean",
          "description": "Enable other member nickname changes policy"
        },
        "memberRoleChanges": {
          "type": "boolean",
          "description": "Enable member role changes policy"
        },
        "memberVoiceAudit": {
          "type": "boolean",
          "description": "Enable member voice audit policy"
        },
        "memberVoiceChanges": {
          "type": "boolean",
          "description": "Enable member voice changes policy"
        },
        "messageForwarding": {
          "type": "boolean",
          "description": "Enable message forwarding policy"
        },
        "crossGuildMessageForwarding": {
          "type": "boolean",
          "description": "Enable cross guild message forwarding policy"
        },
        "nativeCommandChanges": {
          "type": "boolean",
          "description": "Enable native command changes policy"
        },
        "nativeInteractions": {
          "type": "boolean",
          "description": "Enable native interactions policy"
        },
        "onboardingAudit": {
          "type": "boolean",
          "description": "Enable onboarding audit policy"
        },
        "onboardingChanges": {
          "type": "boolean",
          "description": "Enable onboarding changes policy"
        },
        "pinManagement": {
          "type": "boolean",
          "description": "Enable pin management policy"
        },
        "permissionOverwrites": {
          "type": "boolean",
          "description": "Enable permission overwrites policy"
        },
        "pollAudit": {
          "type": "boolean",
          "description": "Enable poll audit policy"
        },
        "pollCreation": {
          "type": "boolean",
          "description": "Enable poll creation policy"
        },
        "pollEnding": {
          "type": "boolean",
          "description": "Enable poll ending policy"
        },
        "pollVoterAudit": {
          "type": "boolean",
          "description": "Enable poll voter audit policy"
        },
        "reactionModeration": {
          "type": "boolean",
          "description": "Enable reaction moderation policy"
        },
        "reactionUserAudit": {
          "type": "boolean",
          "description": "Enable reaction user audit policy"
        },
        "roleCreation": {
          "type": "boolean",
          "description": "Enable role creation policy"
        },
        "roleConfiguration": {
          "type": "boolean",
          "description": "Enable role configuration policy"
        },
        "roleDeletionAudit": {
          "type": "boolean",
          "description": "Enable role deletion audit policy"
        },
        "roleDeletions": {
          "type": "boolean",
          "description": "Enable role deletions policy"
        },
        "roleOrderingAudit": {
          "type": "boolean",
          "description": "Enable role ordering audit policy"
        },
        "roleOrderingChanges": {
          "type": "boolean",
          "description": "Enable role ordering changes policy"
        },
        "scheduledEventAudit": {
          "type": "boolean",
          "description": "Enable scheduled event audit policy"
        },
        "scheduledEventUserAudit": {
          "type": "boolean",
