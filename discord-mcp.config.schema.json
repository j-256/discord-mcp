        "channelDeletionIds": {
          "minItems": 0,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "description": "Exact Discord ID allowlist for channel deletion ids"
        },
        "channelCloneGuildIds": {
          "minItems": 0,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "description": "Exact Discord ID allowlist for channel clone guild ids"
        },
        "channelCloneSourceIds": {
          "minItems": 0,
