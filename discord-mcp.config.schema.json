        "welcomeScreenAudit": {
          "type": "boolean",
          "description": "Enable welcome screen audit policy"
        },
        "welcomeScreenChanges": {
          "type": "boolean",
          "description": "Enable welcome screen changes policy"
        },
        "webhookAudit": {
          "type": "boolean",
          "description": "Enable webhook audit policy"
        },
        "webhookChanges": {
          "type": "boolean",
          "description": "Enable webhook changes policy"
        },
        "webhookCreation": {
          "type": "boolean",
