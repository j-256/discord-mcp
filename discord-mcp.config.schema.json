        },
        "widgetSettingsChanges": {
          "type": "boolean",
          "description": "Enable widget settings changes policy"
        }
      },
      "additionalProperties": false,
      "description": "Explicit capability gates; omitted gates remain disabled"
    },
    "credential": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "environment"
            },
            "variable": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^DISCORD_(?:[A-Z0-9]+_)*TOKEN$"
            }
          },
          "required": [
            "provider",
            "variable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute canonical path to a bounded externally managed Discord token file"
            },
            "provider": {
              "type": "string",
              "const": "file"
            }
          },
          "required": [
            "path",
            "provider"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Environment or bounded file reference for the Discord bot token"
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable the optional privacy-safe Discord Gateway client"
        },
        "eventBufferSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum bounded Gateway event buffer size"
        }
      },
      "required": [
        "enabled",
        "eventBufferSize"
      ],
      "additionalProperties": false,
      "description": "Optional Discord Gateway policy"
    },
    "identity": {
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "Expected Discord application identity"
        },
        "botId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "Expected Discord bot user identity"
        }
      },
      "required": [
        "applicationId",
        "botId"
      ],
      "additionalProperties": false,
      "description": "Pinned Discord application and bot identity"
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "attachmentMaxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Numeric policy limit for attachment max bytes"
        },
        "guildPruneMaxMembers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Numeric policy limit for guild prune max members"
        },
        "interactionMaxWritesPerMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Numeric policy limit for interaction max writes per minute"
        },
        "interactionMinWriteIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Numeric policy limit for interaction min write interval ms"
        },
        "nativeInteractionMaxPending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Numeric policy limit for native interaction max pending"
        },
        "nativeInteractionTtlSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Numeric policy limit for native interaction ttl seconds"
        }
      },
      "additionalProperties": false,
      "description": "Optional numeric policy limits"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "description": "Bounded lowercase identifier for this policy"
    },
    "observability": {
      "default": {},
      "type": "object",
      "properties": {
        "compression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Common OTLP compression mode"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Common credential-free absolute OTLP endpoint"
        },
        "exportEnabled": {
          "type": "boolean",
          "description": "Enable OTLP export"
        },
        "headers": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "environment"
            },
            "variable": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Z][A-Z0-9_]{0,118}_HEADERS$"
            }
          },
          "required": [
            "provider",
            "variable"
          ],
          "additionalProperties": false,
          "description": "Environment reference for an OTLP header string"
        },
        "jsonLogsEnabled": {
          "type": "boolean",
          "description": "Enable content-free JSON operational logs"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "compression": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "OTLP compression mode"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Credential-free absolute OTLP endpoint"
            },
            "headers": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "environment"
                },
                "variable": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[A-Z][A-Z0-9_]{0,118}_HEADERS$"
                }
              },
              "required": [
                "provider",
                "variable"
              ],
              "additionalProperties": false,
              "description": "Environment reference for an OTLP header string"
            },
            "protocol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "OTLP transport protocol"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "OTLP request timeout in milliseconds"
            }
          },
          "additionalProperties": false
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Common OTLP transport protocol"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Bounded non-identifying telemetry service name"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Common OTLP request timeout in milliseconds"
        },
        "traceSampleRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Trace sampling ratio"
        },
        "traceSampler": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Trace sampler name"
        },
        "traces": {
          "type": "object",
          "properties": {
            "compression": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "OTLP compression mode"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Credential-free absolute OTLP endpoint"
            },
            "headers": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "environment"
                },
                "variable": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[A-Z][A-Z0-9_]{0,118}_HEADERS$"
                }
              },
              "required": [
                "provider",
                "variable"
              ],
              "additionalProperties": false,
              "description": "Environment reference for an OTLP header string"
            },
            "protocol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "OTLP transport protocol"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "OTLP request timeout in milliseconds"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Optional content-free local and OTLP observability policy"
    },
    "readScope": {
      "type": "object",
      "properties": {
        "channelIds": {
          "minItems": 0,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "description": "Optional exact channel allowlist inside the guild boundary"
        },
        "guildIds": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "description": "Exact guild allowlist forming the outer read boundary"
        }
      },
      "required": [
        "channelIds",
        "guildIds"
      ],
      "additionalProperties": false,
      "description": "Required outer Discord read boundary"
    },
    "runtime": {
      "default": {},
      "type": "object",
      "properties": {
        "nativeCommandName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Runtime setting for native command name"
        }
      },
      "additionalProperties": false,
      "description": "Optional non-secret runtime settings"
    },
    "schemaVersion": {
      "type": "number",
      "const": 2,
      "description": "Configuration format version"
    },
